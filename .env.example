# --- PostgreSQL (мастер и реплика) ---
POSTGRES_VERSION=15
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_db

# --- Порты на хосте ---
PG_MASTER_PORT=your_master_port
PG_REPLICA_PORT=your_replica_port

# --- Репликация ---
REPLICATION_USER=your_replica_user
REPLICATION_PASSWORD=your_replica_password

# --- Read-only пользователь (для read-подключений) ---
APP_READER_USER=your_exe_read_user
APP_READER_PASSWORD=your_read_password

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=your_rabbit_user
RABBITMQ_DEFAULT_PASS=your_rabbit_password

# --- JWT (для auth) ---
JWT_SECRET_KEY=your_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30